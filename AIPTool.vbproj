<Project Sdk="Microsoft.NET.Sdk">

  <!-- ═══════════════════════════════════════════════════════════════════════
       AIPTool — .NET 8.0（net8.0-windows）SDK 风格工程
       由 .NET Framework 4.8 旧式工程升级而来，旧工程已备份为 AIPTool.vbproj.net48.bak

       注意：本工程是 Inventor 的 COM 外接程序（AddIn）。
       .NET 8 不再支持 RegisterForComInterop，改为 EnableComHosting 生成
       AIPTool.comhost.dll，并在注册表里把 CLSID 的 InprocServer32 指向该文件
       （注册方法见仓库根目录 RegisterAddin.ps1，需管理员身份运行）。
       ═══════════════════════════════════════════════════════════════════════ -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>AIPTool</RootNamespace>
    <AssemblyName>AIPTool</AssemblyName>
    <MyType>WindowsForms</MyType>
    <OptionExplicit>On</OptionExplicit>
    <OptionCompare>Binary</OptionCompare>
    <OptionStrict>Off</OptionStrict>
    <OptionInfer>On</OptionInfer>

    <!-- AssemblyInfo.vb 为手工维护，关闭自动生成以避免程序集特性重复 -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- 生成 comhost，供 Inventor 通过 COM 加载 .NET 8 组件 -->
    <EnableComHosting>true</EnableComHosting>

    <Platforms>AnyCPU;x64</Platforms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <NoWarn>41999,42016,42017,42018,42019,42032,42036,42353,42354,42355;CA1416;MSB3825;MSB3568</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <OutputPath>C:\ProgramData\Autodesk\Inventor Addins\AIPTool\</OutputPath>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ErrorReport>prompt</ErrorReport>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <OutputPath>bin\</OutputPath>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ErrorReport>prompt</ErrorReport>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x64' ">
    <OutputPath>bin\x64\Debug\</OutputPath>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ErrorReport>prompt</ErrorReport>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x64' ">
    <OutputPath>bin\x64\Release\</OutputPath>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ErrorReport>prompt</ErrorReport>
  </PropertyGroup>

  <!-- 全局导入（SDK 已默认导入 System/System.Collections/System.Collections.Generic/
       System.Diagnostics/System.Linq/System.Xml.Linq/Microsoft.VisualBasic/System.Threading.Tasks） -->
  <ItemGroup>
    <Import Include="Inventor" />
    <Import Include="Microsoft.VisualBasic" />
    <Import Include="System" />
    <Import Include="System.Collections" />
    <Import Include="System.Collections.Concurrent" />
    <Import Include="System.Diagnostics" />
    <Import Include="System.Drawing" />
    <Import Include="System.IO" />
    <Import Include="System.IO.Compression" />
    <Import Include="System.Linq" />
    <Import Include="System.Linq.Expressions" />
    <Import Include="System.Runtime.InteropServices" />
    <Import Include="System.Text" />
    <Import Include="System.Threading" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>

  <!-- 引用 -->
  <ItemGroup>
    <!-- Inventor 互操作（默认用工程内 library\ 副本，版本 20.x=Inventor 2021；
         如需按本机 Inventor 版本编译，可改为
         C:\Program Files\Autodesk\Inventor 20xx\Bin\Public Assemblies\Autodesk.Inventor.Interop.dll。
         EmbedInteropTypes 使类型嵌入，运行时不再依赖该 DLL） -->
    <Reference Include="Autodesk.Inventor.Interop">
      <HintPath>library\autodesk.inventor.interop.dll</HintPath>
      <EmbedInteropTypes>True</EmbedInteropTypes>
      <Private>False</Private>
    </Reference>

    <!-- Excel 互操作（类型嵌入，运行时无依赖，也不随输出复制其依赖的 VS 互程序集） -->
    <Reference Include="Interop.Microsoft.Office.Interop.Excel">
      <HintPath>library\Interop.Microsoft.Office.Interop.Excel.dll</HintPath>
      <EmbedInteropTypes>True</EmbedInteropTypes>
      <Private>False</Private>
    </Reference>

    <!-- stdole（IPictureDisp 等）。直接引用工程内副本并嵌入互操作类型：
         不引入 NuGet 包，也不会把 stdole.dll 复制到输出（类型已嵌入程序集） -->
    <Reference Include="stdole">
      <HintPath>library\stdole.dll</HintPath>
      <EmbedInteropTypes>True</EmbedInteropTypes>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- 以下文件不在原 .NET Framework 工程中（草稿/历史遗留），SDK 默认全局 glob 会拾取，需排除 -->
  <ItemGroup>
    <Compile Remove="clsBomTool.vb" />
    <Compile Remove="Class\clsGetSketchPoint.vb" />
    <Compile Remove="Class\clsMiniToolbar.vb" />
    <Compile Remove="Class\clsSketchPointPicker.vb" />
    <Compile Remove="Class\PictureConverter.vb" />
    <Compile Remove="Form\formMain.vb" />
    <Compile Remove="Form\formMain.Designer.vb" />
    <Compile Remove="Form\FrmProjectManager.vb" />
    <Compile Remove="Form\FrmProjectManager.Designer.vb" />
    <Compile Remove="Module\BrowserFolder.vb" />
    <Compile Remove="Module\Test.vb" />
    <Compile Remove="Module\WRXml.vb" />
    <Compile Remove="My Project\AssemblyInfo.vb" />
    <Compile Remove="My Project\Settings.Designer.vb" />
    <EmbeddedResource Remove="Form\formMain.resx" />
    <EmbeddedResource Remove="Form\FormProjectManager.resx" />
    <EmbeddedResource Remove="Form\FrmProjectManager.resx" />
  </ItemGroup>

  <!-- My.Resources 的基名由 My Project\Resources.Designer.vb 指定（本工程为 AIPTool.Resources），
       由 VB 目标的 CreateManifestResourceNames 自动按该规则命名，无需手工指定 LogicalName。
       app.config 仅用于 .NET Framework 的 My.Application.Log，.NET 8 类库不需要，排除以免生成 AIPTool.dll.config -->
  <ItemGroup>
    <None Update="My Project\Application.myapp" />
    <None Update="My Project\Settings.settings" />
    <None Remove="app.config" />
  </ItemGroup>

  <!-- Excel 互程序集会连带解析出 VS 互程序集（本工程未直接使用，且互操作类型已嵌入），
       从输出目录剔除，保持与 .NET Framework 版一致的产物清单 -->
  <Target Name="RemoveUnusedVsInteropFromOutput" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)"
        Condition="'%(FileName)%(Extension)' == 'Microsoft.VisualStudio.Interop.dll' Or '%(FileName)%(Extension)' == 'Microsoft.VisualStudio.Imaging.Interop.14.0.DesignTime.dll'" />
    </ItemGroup>
  </Target>

  <!-- .NET SDK 生成的 comhost 会保留较早的时间戳，增量复制时可能被判定为“未更改”而跳过，
       导致输出目录里的 comhost 是旧版（例如未包含新标记的 COM 类，Inventor 启动即闪退）。
       这里在生成后强制刷新一次，保证输出目录里的 comhost 与最新构建一致。 -->
  <Target Name="RefreshComHostInOutput" AfterTargets="Build" Condition="'$(EnableComHosting)' == 'true'">
    <ItemGroup>
      <_ComHostFiles Include="$(IntermediateOutputPath)AIPTool.comhost.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_ComHostFiles)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="false" ContinueOnError="true" />
  </Target>

</Project>
